flowchart TB

    subgraph FIG["Обычный редактор макетов"]
        direction TB
        F1["Человек двигает объекты<br/>мышью"] --> F2["Источник истины — ГЕОМЕТРИЯ<br/>у каждого объекта свои x, y, ширина, высота"]
        F2 --> F3["Экран рисуется<br/>ровно как лежит"]
        F4["Агента можно приделать<br/>только сверху"] -.->|"он тоже двигает пиксели"| F2
        F4 --> F5["Проверить его правку нечем:<br/>«неудачно» и «сломано» —<br/>одно и то же число"]
    end

    subgraph IMG["Imago"]
        direction TB
        I1["Человек говорит намерение:<br/>«сделай список в две колонки»"] --> I2["Агент переводит намерение<br/>в ОПЕРАЦИИ над структурой<br/>create · remove · set · move · setToken"]
        I2 --> I3["Источник истины — СТРУКТУРА<br/>что в чём лежит, поток, отступы,<br/>размер: фикс / по содержимому / во всё место"]
        I3 --> I4["Решатель считает геометрию<br/>детерминированно:<br/>одна структура — всегда одна картинка"]
        I4 --> I5["Валидатор проверяет результат<br/>до того, как человек его увидит"]
        I5 -->|"сломалось"| I2
        I5 -->|"годится"| I6["Транзакция с обратными операциями<br/>«Отменить» — одна кнопка"]
    end

    FIG ~~~ IMG

    K1["Геометрия здесь не данные,<br/>а функция от структуры.<br/>Это и есть ставка"]
    K2["Структура — язык,<br/>на котором модель говорит надёжно.<br/>Пиксели — нет"]
    K3["Модель не трогает документ:<br/>она предлагает патч,<br/>детерминированный слой его проверяет,<br/>применяет и умеет отказать"]
    K4["Ошибка агента стоит одну отмену,<br/>а не сломанный макет"]

    I3 --- K1
    I2 --- K2
    I2 --- K3
    I6 --- K4

    classDef old fill:#3a3f4b,stroke:#5b6270,color:#e8eaee
    classDef new fill:#ff6b3d,stroke:#ff6b3d,color:#14161c
    classDef key fill:#38d6b0,stroke:#38d6b0,color:#14161c
    class F1,F2,F3,F4,F5 old
    class I1,I2,I3,I4,I5,I6 new
    class K1,K2,K3,K4 key
