erDiagram
    WORKSPACES ||--o{ MEMBERSHIPS : "кто в пространстве"
    USERS ||--o{ MEMBERSHIPS : ""
    WORKSPACES ||--o{ LIBRARIES : "владеет"
    LIBRARIES ||--o{ LIBRARY_VERSIONS : "неизменяемые версии"
    WORKSPACES ||--o{ PROJECTS : "владеет"
    LIBRARY_VERSIONS ||--o{ PROJECTS : "проект прибит к версии"
    PROJECTS ||--o{ OPERATIONS : "журнал — источник истины"
    PROJECTS ||--o{ SNAPSHOTS : "снимки для открытия"
    PROJECTS ||--o{ COMPONENT_USAGE : "какие компоненты стоят"
    PROJECTS ||--o{ AGENT_RUNS : "трассы команд"
    WORKSPACES ||--o{ ASSETS : "картинки"

    WORKSPACES {
        uuid id PK
        text name
        timestamptz created_at
    }
    USERS {
        uuid id PK
        text email UK
        text name
    }
    MEMBERSHIPS {
        uuid workspace_id PK, FK
        uuid user_id PK, FK
        text role "owner · editor · viewer"
    }
    LIBRARIES {
        uuid id PK
        uuid workspace_id FK
        text name
        int head_version
    }
    LIBRARY_VERSIONS {
        uuid library_id PK, FK
        int version PK
        jsonb content "components · scales · tokens"
        uuid created_by FK
        text note
        timestamptz created_at
    }
    PROJECTS {
        uuid id PK
        uuid workspace_id FK
        text name
        uuid library_id FK
        int library_version FK
        bigint head_seq "номер последней операции"
        timestamptz updated_at
    }
    OPERATIONS {
        uuid project_id PK, FK
        bigint seq PK "номер, выдаёт DSLTS"
        uuid tx_id "транзакция: одна команда = один tx"
        jsonb ops "create · remove · set · move · setToken"
        jsonb inverse "обратные операции — для отмены"
        text author_kind "human · agent"
        uuid author_id FK
        bigint base_seq "поверх чего слал клиент"
        text title "как показать в истории"
        timestamptz created_at
    }
    SNAPSHOTS {
        uuid project_id PK, FK
        bigint seq PK "стейт после этой операции"
        jsonb state "root, nodes"
        timestamptz created_at
    }
    COMPONENT_USAGE {
        uuid project_id PK, FK
        uuid component_id PK
        int instances
    }
    ASSETS {
        uuid id PK
        uuid workspace_id FK
        text storage_key
        text mime
        int bytes
    }
    AGENT_RUNS {
        uuid id PK
        uuid project_id FK
        uuid user_id FK
        uuid tx_id FK "какая транзакция вышла"
        text utterance
        text intent
        jsonb warnings
        text model
        int calls
        int tokens_in
        int tokens_out
        int ms
        text status "ok · retry · failed · cancelled"
        timestamptz created_at
    }
