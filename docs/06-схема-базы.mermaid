erDiagram
    %% Круг 31: базу восстановили из копии, снятой до миграций (например, до 009/010), под
    %% работающим экземпляром — Document service сверяет schema_migrations с каталогом при
    %% переподключении LISTEN и на ошибке 42703/42P01, догоняет миграции под тем же advisory-lock;
    %% пока не догнал — /api/health 503 detail.storage = schema.
    PROJECTS ||--o{ OPERATIONS : "журнал — источник истины"
    PROJECTS ||--o{ SNAPSHOTS : "снимки для открытия"
    PROJECTS ||--o{ LIBRARY_VERSIONS : "проект вида library: помеченные снимки"
    PROJECTS ||--o{ PROJECT_IMPORTS : "продукт импортирует библиотеку"
    LIBRARY_VERSIONS ||--o{ PROJECT_IMPORTS : "прибит к версии"
    PROJECTS ||--o{ PROJECT_EPOCHS : "эпохи журнала (откаты базы)"
    PROJECTS ||--o{ TRACES : "трассы команд агента"
    TRACES ||--o| AGENT_RUNS : "фаза 2: трасса по колонкам"
    WORKSPACES ||--o{ PROJECTS : "владеет (фаза 2)"
    WORKSPACES ||--o{ MEMBERSHIPS : "кто в пространстве (фаза 2)"
    USERS ||--o{ MEMBERSHIPS : ""
    WORKSPACES ||--o{ ASSETS : "картинки (фаза 2)"

    PROJECTS {
        uuid id PK
        text name
        text kind "design · library"
        bigint head_seq "номер последней транзакции — точка сериализации"
        text head_chain "chain записи head_seq; '' у пустого журнала"
        text epoch "эпоха журнала: случайная метка, меняется при откате базы"
        text epoch_cause "init · instance · client"
        int engine "версия формата движка"
        uuid workspace_id FK "фаза 2"
        timestamptz created_at
        timestamptz updated_at "индекс (updated_at DESC, id DESC) — страницы списка (008)"
    }
    OPERATIONS {
        uuid project_id PK, FK
        bigint seq PK "присваивает DSLTS"
        text tx_id UK "с project_id — ключ идемпотентности"
        bigint base_seq "поверх чего слал клиент"
        jsonb ops "ПРИМЕНЁННАЯ форма после слияния"
        jsonb dropped "что не пережило слияние, с причиной"
        text undo_of "tx_id отменяемой"
        text redo_of "tx_id повторяемой"
        text author "отображаемое имя"
        text author_kind "human · agent · system"
        text client "clientId вкладки"
        text title "как показать в истории"
        text command_id "команда агента, породившая запись; NULL — человек (круг 25)"
        text command_author "кто дал команду агенту (≤ 200); NULL — человек, старая запись или старый экземпляр (010, круг 30)"
        int engine
        text chain "sha256(prev_chain + tx_id + seq); CHECK not null; NULL от старого экземпляра — считает триггер"
        int ops_bytes "байты JSON ops + dropped (пишет экземпляр; старый — NULL, считает триггер по jsonb::text): окно страницы журнала без чтения jsonb (009)"
        int ops_count "число операций: история без чтения ops; NULL от старого экземпляра — считает триггер (009)"
        timestamptz created_at
    }
    SNAPSHOTS {
        uuid project_id PK, FK
        bigint seq PK "документ после этой транзакции"
        jsonb doc "root · nodes · tokens · meta — целиком"
        int engine
        text chain "chain записи seq; снимок без совпадения с журналом не отдаётся"
        jsonb tombstones "parents v1: id удалённого → родитель; NULL по умолчанию (007)"
        jsonb tombstones_meta "v2 без parents: {v:2, seq: id → seq удаления}; NULL — номеров нет (007)"
        text tombstones_chain "chain, для которой надгробия известны; NULL или ≠ chain — неизвестны (007)"
        timestamptz created_at
    }
    PROJECT_EPOCHS {
        uuid project_id PK, FK
        text epoch PK
        bigint seq "голова, на которой эпоха началась"
        text cause "init · instance · client"
        timestamptz created_at
    }
    TRACES {
        bigint id PK
        uuid project_id FK
        text command_id
        jsonb body "шаги, длительности, вызовы модели; ≤ 64 КБ; без ключей и промптов"
        timestamptz created_at
    }
    SCHEMA_MIGRATIONS {
        text name PK "NNN_имя.sql|mjs"
        timestamptz applied_at
    }
    LIBRARY_VERSIONS {
        uuid project_id PK, FK
        text tag PK "v5"
        bigint seq "какой снимок помечен"
        text note
        timestamptz created_at
    }
    PROJECT_IMPORTS {
        uuid project_id PK, FK
        uuid library_id PK, FK
        text version_tag FK
        timestamptz imported_at
    }
    AGENT_RUNS {
        text note "фаза 2: разбор трасс по колонкам; сейчас — TRACES.body"

        uuid id PK
        uuid project_id FK
        text tx_id "какая транзакция вышла"
        text author
        text utterance
        text intent
        jsonb plan
        jsonb warnings
        text model
        int calls
        int tokens_in
        int tokens_out
        int ms
        text status "queued · running · ok · retry · failed · cancelled"
        timestamptz created_at
    }
    WORKSPACES {
        uuid id PK
        text name
        timestamptz created_at
    }
    USERS {
        uuid id PK
        text email UK
        text name
    }
    MEMBERSHIPS {
        uuid workspace_id PK, FK
        uuid user_id PK, FK
        text role "owner · editor · viewer"
    }
    ASSETS {
        uuid id PK
        uuid workspace_id FK
        text storage_key
        text sha256
        text mime
        bigint bytes
    }
