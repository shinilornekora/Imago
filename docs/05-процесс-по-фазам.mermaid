flowchart LR

    subgraph P1["1 · Команда"]
        direction TB
        A1["Человек говорит:<br/>«добавь в шапку кнопку Войти»"]
        A2["Шлюз ставит задачу<br/>в очередь агента"]
        A1 --> A2
    end

    subgraph P2["2 · Агент собирает контекст"]
        direction TB
        B1["Берёт словарь у библиотеки:<br/>Кнопка, Карточка, Метка…"]
        B2["Берёт выжимку документа:<br/>структура, без геометрии"]
        B1 --> B2
    end

    subgraph P3["3 · Модель"]
        direction TB
        C1["Вызов 1 — план:<br/>что за просьба, куда правка"]
        C2["Вызов 2 — патч:<br/>«экземпляр Кнопки, текст = Войти»"]
        C1 --> C2
    end

    subgraph P4["4 · Проверка"]
        direction TB
        D1["Агент отсекает выдуманное,<br/>переводит патч в операции"]
        D2["Сервис документов применяет,<br/>движок считает раскладку"]
        D3{"Валидатор:<br/>всё в порядке?"}
        D4["Вызов 3 — починка<br/>до показа человеку"]
        D1 --> D2 --> D3
        D3 -->|"нет"| D4 --> D2
    end

    subgraph P5["5 · Результат"]
        direction TB
        E1["Клиенту по WebSocket:<br/>новая версия + «Готово»"]
        E2["Человек видит макет<br/>и карточку с «Отменить»"]
        E3["Отмена = обратные операции,<br/>версия как была"]
        E1 --> E2
        E2 -.->|"передумал"| E3
    end

    A2 --> B1
    B2 --> C1
    C2 --> D1
    D3 -->|"да"| E1

    A2 -.->|"«Планирую», «Собираю правки»<br/>— стадии идут человеку по ходу"| E2

    classDef human fill:#1b6ef3,stroke:#1b6ef3,color:#fff
    classDef agent fill:#ff6b3d,stroke:#ff6b3d,color:#14161c
    classDef model fill:#5b6270,stroke:#5b6270,color:#fff
    classDef check fill:#38d6b0,stroke:#38d6b0,color:#14161c
    class A1,E2,E3 human
    class A2,B1,B2,D1,E1 agent
    class C1,C2,D4 model
    class D2,D3 check
