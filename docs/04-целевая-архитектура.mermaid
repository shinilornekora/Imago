flowchart LR

    U(("Человек"))
    NGINX["NGINX"]
    CLIENT["CLIENT<br/>оболочка + движок · реплика с локальным журналом"]
    ORCH["Orchestrator<br/>процесс «агент» · знает только сервисы"]
    JEV["JEV<br/>команда оболочки?"]
    DUIL["DUIL<br/>Design UI Library — срез проекта-библиотеки"]
    DSLR["DSLR<br/>DSL Reader — снимок + хвост журнала"]
    LLM["LLM"]
    DSLV["DSLV<br/>DSL Validator — движок, копия, суд"]
    DSLTS["DSLTS<br/>DSL Transaction — секвенсор: сливает, нумерует, пишет"]
    HUB["Hub<br/>рассылка по WS · присутствие"]
    TR["Трассы агента<br/>/api/internal/traces — только изнутри сети"]
    DB[("PostgreSQL<br/>журнал операций · снимки · проекты и библиотеки")]

    CLIENT -->|"0 · открыть проект"| DSLR
    DSLR -->|"0 · снимок + хвост, номер головы"| CLIENT
    U -->|"1 · HTTPS"| NGINX
    NGINX -->|"2"| CLIENT
    CLIENT -->|"3 · команда агенту"| ORCH
    ORCH -->|"4"| JEV
    JEV -->|"5 · да → событие shell, клиент исполняет команду оболочки сам / нет"| ORCH
    ORCH -->|"4a"| DSLR
    DSLR -->|"5a · стейт + номер"| ORCH
    ORCH -->|"6"| DUIL
    DUIL -->|"6a · проекты-библиотеки — через клиент DSLR, по HTTP"| DSLR
    DSLR -->|"7a · их стейт"| DUIL
    DUIL -->|"7 · словарь компонентов"| ORCH
    ORCH -->|"8 · промпт"| LLM
    LLM -->|"9 · патч"| ORCH
    ORCH -->|"10 · стейт + патч"| DSLV
    DSLV -->|"11 · годные операции / нарушение → снова 8"| ORCH
    ORCH -->|"12 · транзакция + номер базы"| DSLTS
    DSLTS -->|"13 · номер, применённые операции, отброшенные"| ORCH
    CLIENT -->|"M · ручная правка = транзакция"| DSLTS
    DSLTS -->|"12a · дописывает журнал, раз в N — снимок"| DB
    DSLTS -->|"12b · каждая транзакция"| HUB
    HUB -->|"всем подписчикам проекта, автору тоже"| CLIENT
    DB -->|"снимок + хвост"| DSLR
    ORCH -->|"7b · стадии по ходу работы; команды оболочки — событием shell"| CLIENT
    ORCH -->|"T · трасса команды (POST, X-Internal-Token)"| TR
    TR -->|"таблица traces"| DB

    classDef human fill:#1b6ef3,stroke:#1b6ef3,color:#fff
    classDef infra fill:#7c6cf5,stroke:#7c6cf5,color:#fff
    classDef orch fill:#ff6b3d,stroke:#ff6b3d,color:#14161c
    classDef svc fill:#ffb08a,stroke:#ff6b3d,color:#14161c
    classDef docsvc fill:#ffd9c2,stroke:#ff6b3d,color:#14161c
    classDef model fill:#5b6270,stroke:#5b6270,color:#fff
    classDef jev fill:#2f3a4a,stroke:#38d6b0,color:#fff
    classDef store fill:#38d6b0,stroke:#38d6b0,color:#14161c
    class U,CLIENT human
    class NGINX infra
    class ORCH orch
    class DUIL,DSLV svc
    class DSLR,DSLTS,HUB,TR docsvc
    class LLM model
    class JEV jev
    class DB store

    %% Два процесса: Document service = DSLR + DSLTS + Hub + приём трасс (светлые), Orchestrator = JEV + DUIL + DSLV + LLM-клиент.
    %% К базе ходит только Document service: DUIL читает библиотеки через DSLR по HTTP (круг 25 — схема приведена к коду).
