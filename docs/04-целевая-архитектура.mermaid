flowchart LR

    U(("Человек"))
    NGINX["NGINX"]
    CLIENT["CLIENT<br/>оболочка + движок · свои правки применяет сразу"]
    ORCH["Orchestrator<br/>знает только сервисы"]
    JEV["JEV<br/>команда оболочки?"]
    DUIL["DUIL<br/>Design UI Library — читает библиотеки"]
    DSLR["DSLR<br/>DSL Reader — снимок + хвост журнала"]
    LLM["LLM"]
    DSLV["DSLV<br/>DSL Validator — движок, копия, суд"]
    DSLTS["DSLTS<br/>DSL Transaction — секвенсор: нумерует, перекладывает, пишет, рассылает"]
    DB[("База<br/>журнал операций · снимки · библиотеки")]

    CLIENT -->|"0 · открыть проект"| ORCH
    ORCH -->|"0"| DSLR
    DSLR -->|"0 · стейт + номер последней операции"| ORCH
    U -->|"1 · HTTPS"| NGINX
    NGINX -->|"2"| CLIENT
    CLIENT -->|"3 · команда агенту / ручная правка = транзакция"| ORCH
    ORCH -->|"4"| JEV
    JEV -->|"5 · да / нет"| ORCH
    ORCH -->|"6"| DUIL
    DUIL -->|"7 · словарь компонентов"| ORCH
    ORCH -->|"8 · промпт"| LLM
    LLM -->|"9 · патч"| ORCH
    ORCH -->|"10 · стейт + патч"| DSLV
    DSLV -->|"11 · годные операции / нарушение → снова 8"| ORCH
    ORCH -->|"12 · транзакция + номер базы"| DSLTS
    DSLTS -->|"13 · номер, при перекладке — что изменилось"| ORCH
    DSLTS -->|"12a · дописывает журнал, раз в N — снимок"| DB
    DB -->|"срез библиотек"| DUIL
    DB -->|"снимок + хвост"| DSLR
    ORCH -->|"6a · при открытии — стейт; дальше — каждая транзакция всем, стадии, присутствие"| CLIENT

    classDef human fill:#1b6ef3,stroke:#1b6ef3,color:#fff
    classDef infra fill:#7c6cf5,stroke:#7c6cf5,color:#fff
    classDef orch fill:#ff6b3d,stroke:#ff6b3d,color:#14161c
    classDef svc fill:#ffb08a,stroke:#ff6b3d,color:#14161c
    classDef model fill:#5b6270,stroke:#5b6270,color:#fff
    classDef jev fill:#2f3a4a,stroke:#38d6b0,color:#fff
    classDef store fill:#38d6b0,stroke:#38d6b0,color:#14161c
    class U,CLIENT human
    class NGINX infra
    class ORCH orch
    class DUIL,DSLR,DSLV,DSLTS svc
    class LLM model
    class JEV jev
    class DB store
