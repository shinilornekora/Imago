# Document service (SPEC §8.1): один процесс Node — DSLR + DSLTS + Hub.
# Движок src/core.js тот же, что у клиента, поэтому копируется целиком src/.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY server ./server
EXPOSE 8080
USER node
CMD ["node", "server/document/index.js"]
