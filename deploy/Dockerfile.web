# NGINX (SPEC §8.1): статика клиента + прокси /api и /ws на Document service, /agent на Orchestrator.
# Клиент собирается тут же (tools/build.mjs → dist/web, IMAGO_DEFAULTS.server: true), чтобы
# docker compose up не требовал Node на машине.
FROM node:22-alpine AS build
WORKDIR /app
COPY index.html app.js styles.css ./
COPY src ./src
COPY tools ./tools
RUN node tools/build.mjs

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/web /usr/share/nginx/html
EXPOSE 80
