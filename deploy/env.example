# Imago Studio — переменные docker compose. Скопируйте в .env в корне репозитория
# (рядом с docker-compose.yml) и поправьте под себя; без .env действуют умолчания.

# Порт, на котором открывается редактор: http://localhost:8123/
IMAGO_PORT=8123

# Модель для агента на сервере (Orchestrator). По умолчанию — LM Studio на этой же машине:
# из контейнера она видна как host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=local-model
# LLM_KIND=openai              # или anthropic
# LLM_API_KEY=                 # ключ облачной модели; в логи и ответы не попадает

# Общий секрет Orchestrator → Document service для записи трасс агента (/api/internal/traces).
# Пока здесь заглушка change-me, Document service её не принимает и трассы не пишутся —
# редактор и агент при этом работают. Своё значение, например: openssl rand -hex 24
INTERNAL_TOKEN=change-me
