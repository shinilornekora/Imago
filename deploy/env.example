# Imago Studio — переменные docker compose. Скопируйте в .env в корне репозитория
# (рядом с docker-compose.yml) и поправьте под себя; без .env действуют умолчания.

# Порт, на котором открывается редактор: http://localhost:8123/
IMAGO_PORT=8123

# Модель для агента на сервере (Orchestrator). По умолчанию — LM Studio на этой же машине:
# из контейнера она видна как host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=local-model
# LLM_KIND=openai              # или anthropic
# LLM_API_KEY=                 # ключ облачной модели; в логи и ответы не попадает

# Общий секрет Orchestrator → Document service для записи трасс агента (/api/internal/traces).
# Пока здесь заглушка change-me, Document service её не принимает и трассы не пишутся —
# редактор и агент при этом работают. Своё значение, например: openssl rand -hex 24
INTERNAL_TOKEN=change-me

# Пределы сервисов. Без строки — умолчание (оно же указано здесь); раскомментируйте и
# поменяйте, если нужно. Подробно — server/document/README.md и server/orchestrator/README.md.

# Document service: снимок раз в N транзакций, сколько снимков хранить, дедлайн запроса к базе (мс)
# SNAPSHOT_EVERY=50
# SNAPSHOT_KEEP=5
# DB_TIMEOUT_MS=8000
# присутствие без вестей столько мс — участник ушёл
# PRESENCE_TTL_MS=45000
# сокеты: необработанных транзакций на сокет; сокетов одновременно от подключения до hello
# WS_INFLIGHT=2
# WS_CONNECTING=6
# запись по HTTP: одновременно; в очереди; бюджет читаемых тел, байт (64 МиБ); срок тела, мс
# HTTP_WRITE_CONCURRENCY=8
# HTTP_WRITE_QUEUE=64
# WRITE_BODY_BYTES=67108864
# BODY_TIMEOUT_MS=30000
# очереди секвенсора: проекта — байт (32 МиБ) и транзакций; всего экземпляра — байт (128 МиБ)
# QUEUE_PROJECT_BYTES=33554432
# QUEUE_PROJECT_TXS=256
# QUEUE_TOTAL_BYTES=134217728
# надгробия удалённых узлов: окно в seq, шаг прореживания, наибольшее число
# TOMB_KEEP_SEQ=10000
# TOMB_PRUNE_EVERY=500
# TOMB_MAX=50000
# выжимки последних транзакций в памяти: штук и байт (16 МиБ)
# RECENT_TXS=500
# RECENT_BYTES=16777216
# головы проектов в памяти — байт документов (256 МиБ); кеш снимков открытия — байт (128 МиБ, 0 — без кеша)
# HEADS_BYTES=268435456
# SNAPSHOT_CACHE_BYTES=134217728
# импорт документа (новый проект с документом) в потоках: одновременно; в очереди (сверх — 503 busy)
# IMPORT_CONCURRENCY=2
# IMPORT_QUEUE=8
# срок задачи импорта (очередь + подготовка), мс; дольше — 503, поток заменяется новым
# IMPORT_TASK_MS=30000

# Orchestrator: дедлайн запроса к модели (мс); воркеры расчёта — сколько (пусто — min(2, ядра)),
# куча воркера (МБ), счётное время прогона (мс), заданий на воркер, очередь пула и её срок (мс);
# ждущих команд на проект
# LLM_TIMEOUT_MS=120000
# потолок тела ответа модели, байт (больше — «ответ модели не удалось разобрать»)
# LLM_MAX_BODY_BYTES=8388608
# видит ли модель картинки (снимок доски для критика, круг 47): 1 — да, 0 — нет;
# пусто — у openai-совместимой нет (текстовые модели картинку молча выбрасывают), у anthropic — да
# LLM_VISION=
# живой дизайн (круг 47): шаг арт-направления перед раскладкой, визуальный критик с одним кругом
# доработки и снимок доски для него (PNG через @resvg/resvg-js, шрифты — с Google Fonts); 0 — выключить
# AGENT_DIRECTION=1
# AGENT_CRITIC=1
# AGENT_RENDER=1
# WORKERS=
# WORKER_MAX_MB=512
# WORKER_TIMEOUT_MS=60000
# WORKER_JOBS=4
# POOL_QUEUE_MAX=32
# POOL_QUEUE_WAIT_MS=30000
# QUEUE_MAX=4
# полные чтения документа у Document service: одновременно и суммарно байт (сверх — очередь,
# человек видит «в очереди»)
# DSLR_FULL_CONCURRENCY=4
# DSLR_FULL_BYTES=67108864
