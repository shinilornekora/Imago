# сгенерированные документы стенда: детерминированы (scripts/gen-all.sh), в репозиторий не кладём —
# контрольные суммы лежат рядом в data/*.sha256
data/*.json

# сырые записи прогонов: 58 тыс. файлов / ~2 ГБ. В репозиторий попадают сводные runs.csv,
# паспорта серий и отчёты анализа (docs/results/**)
results/*/runs/
results/*/reference/
results/*/snapshots/
results/functional/*/artifacts/

# временные файлы
shot.mjs
/tmp/
