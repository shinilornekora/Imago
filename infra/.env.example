# Скопируйте в infra/.env и заполните. Секреты в репозиторий не коммитятся (§1.9).

# Секрет подписи JWT (HS256). Тот же секрет получает zero-cache как ZERO_AUTH_SECRET.
# В клиентскую сборку не попадает (проверка: grep -r STAND_JWT_SECRET packages/client/dist).
STAND_JWT_SECRET=change-me-please

# Тестовые хуки /api/test/* (сброс документа, задержка ответа). В измеряемый путь не входят.
# ПО УМОЛЧАНИЮ ВЫКЛЮЧЕНЫ: в контуре Compose api слушает 0.0.0.0, а Caddy публикует единственный
# порт наружу, поэтому включённые хуки без секрета = сброс чужого документа без токена.
# Чтобы включить, нужны ОБА условия:
#   STAND_TEST_HOOKS=1 и НЕПУСТОЙ STAND_TEST_HOOKS_SECRET (иначе api не поднимется: см.
#   packages/server/src/app.ts — при непетлевой привязке пустой секрет запрещён);
#   STAND_CADDY_TEST_HOOKS_MATCH — иначе Caddy отвечает 403 на /api/test/* (см. ниже).
# Сгенерировать секрет: openssl rand -hex 24
STAND_TEST_HOOKS=0
STAND_TEST_HOOKS_SECRET=

# Путь, который Caddy закрывает 403. Значение по умолчанию закрывает тестовые хуки.
# Чтобы опубликовать их осознанно, поставьте путь-заглушку, который ничему не соответствует:
#   STAND_CADDY_TEST_HOOKS_MATCH=/__test_hooks_published__
# Пустым НЕ оставляйте: подстановка попадает прямо в матчер Caddyfile.
STAND_CADDY_TEST_HOOKS_MATCH=/api/test/*

STAND_LOG_LEVEL=warn

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=editor

# Пароль административных интерфейсов zero-cache (/statz, /heapz, inspector).
# Значения по умолчанию НЕТ намеренно: compose остановится, если не задать.
# Сгенерировать: openssl rand -hex 24
ZERO_ADMIN_PASSWORD=

# Публикуемый порт Caddy и интерфейс привязки. 127.0.0.1 — стенд не выставляется в сеть;
# 0.0.0.0 задавайте осознанно, когда клиент работает на отдельном устройстве (§1.2).
STAND_PUBLIC_PORT=8080
STAND_PUBLIC_BIND=127.0.0.1
