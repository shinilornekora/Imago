{
  "name": "@stand/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./db": {
      "types": "./dist/db/sql.d.ts",
      "import": "./dist/db/sql.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test test/domain.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/http-proxy": "11.6.2",
    "@fastify/jwt": "10.2.2",
    "@fastify/static": "10.1.3",
    "@rocicorp/zero": "1.9.0",
    "@stand/shared": "0.1.0",
    "fastify": "5.12.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
